{
  "name": "inkless",
  "private": true,
  "version": "0.1.0-alpha.2",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm -C frontend dev",
    "dev:theme-product-first": "THEME_PRODUCT_FIRST_PATH=../inkless-theme-product-first VITE_API_BASE_URL=http://localhost:8088 pnpm -C frontend dev",
    "dev:theme-blog-first": "THEME_BLOG_FIRST_PATH=../inkless-theme-blog-first VITE_API_BASE_URL=http://localhost:8088 pnpm -C frontend dev",
    "dev:theme-editorial-firm": "THEME_EDITORIAL_FIRM_PATH=../inkless-theme-editorial-firm VITE_API_BASE_URL=http://localhost:8088 pnpm -C frontend dev",
    "dev:up": "make dev-up",
    "build": "pnpm -C frontend build",
    "preview": "pnpm -C frontend preview",
    "lint": "pnpm -C frontend lint",
    "type-check": "pnpm -C frontend type-check",
    "build:theme-blog-first": "cd frontend/node_modules/@inkless/theme-blog-first && npm install --ignore-scripts --no-fund --no-audit && npm run build",
    "build:theme-product-first": "cd frontend/node_modules/@inkless/theme-product-first && npm install --ignore-scripts --no-fund --no-audit && npm run build",
    "build:theme-corporate-classic": "pnpm --filter @inkless/theme-corporate-classic type-check",
    "build:theme-editorial-firm": "cd frontend/node_modules/@inkless/theme-editorial-firm && npm install --ignore-scripts --no-fund --no-audit && npm run build",
    "theme:umd:smoke": "pnpm run build:theme-blog-first && node scripts/theme-umd-smoke.mjs blog-first",
    "theme:umd:smoke:editorial-firm": "pnpm run build:theme-editorial-firm && node scripts/theme-umd-smoke.mjs editorial-firm",
    "test": "pnpm -C frontend test:run",
    "test:run": "pnpm -C frontend test:run",
    "test:e2e": "node test/e2e/admin-navigation.mjs",
    "agent:init": "node scripts/long-agent.mjs --init-only",
    "agent:run": "node scripts/long-agent.mjs",
    "agent:usage": "node scripts/agent-usage.mjs",
    "build:frontend": "./scripts/build-frontend.sh",
    "build:backend": "./scripts/build-backend.sh",
    "deploy": "./scripts/deploy.sh",
    "deploy:http": "./scripts/deploy-http.sh",
    "rollback": "./scripts/rollback.sh",
    "migrate:db": "./scripts/migrate-db.sh"
  },
  "devDependencies": {
    "playwright": "^1.58.2"
  },
  "pnpm": {
    "overrides": {
      "@tiptap/core": "3.28.0",
      "@tiptap/pm": "3.28.0",
      "@tiptap/react": "3.28.0",
      "@tiptap/starter-kit": "3.28.0",
      "@tiptap/suggestion": "3.28.0",
      "@tiptap/extensions": "3.28.0",
      "@tiptap/extension-list": "3.28.0",
      "@tiptap/extension-blockquote": "3.28.0",
      "@tiptap/extension-bold": "3.28.0",
      "@tiptap/extension-bubble-menu": "3.28.0",
      "@tiptap/extension-bullet-list": "3.28.0",
      "@tiptap/extension-character-count": "3.28.0",
      "@tiptap/extension-code": "3.28.0",
      "@tiptap/extension-code-block": "3.28.0",
      "@tiptap/extension-code-block-lowlight": "3.28.0",
      "@tiptap/extension-color": "3.28.0",
      "@tiptap/extension-details": "3.28.0",
      "@tiptap/extension-document": "3.28.0",
      "@tiptap/extension-dropcursor": "3.28.0",
      "@tiptap/extension-floating-menu": "3.28.0",
      "@tiptap/extension-gapcursor": "3.28.0",
      "@tiptap/extension-hard-break": "3.28.0",
      "@tiptap/extension-heading": "3.28.0",
      "@tiptap/extension-highlight": "3.28.0",
      "@tiptap/extension-horizontal-rule": "3.28.0",
      "@tiptap/extension-image": "3.28.0",
      "@tiptap/extension-italic": "3.28.0",
      "@tiptap/extension-link": "3.28.0",
      "@tiptap/extension-list-item": "3.28.0",
      "@tiptap/extension-list-keymap": "3.28.0",
      "@tiptap/extension-ordered-list": "3.28.0",
      "@tiptap/extension-paragraph": "3.28.0",
      "@tiptap/extension-placeholder": "3.28.0",
      "@tiptap/extension-strike": "3.28.0",
      "@tiptap/extension-subscript": "3.28.0",
      "@tiptap/extension-superscript": "3.28.0",
      "@tiptap/extension-table": "3.28.0",
      "@tiptap/extension-table-cell": "3.28.0",
      "@tiptap/extension-table-header": "3.28.0",
      "@tiptap/extension-table-row": "3.28.0",
      "@tiptap/extension-task-item": "3.28.0",
      "@tiptap/extension-task-list": "3.28.0",
      "@tiptap/extension-text": "3.28.0",
      "@tiptap/extension-text-align": "3.28.0",
      "@tiptap/extension-text-style": "3.28.0",
      "@tiptap/extension-typography": "3.28.0",
      "@tiptap/extension-underline": "3.28.0",
      "@tiptap/extension-youtube": "3.28.0"
    }
  }
}
